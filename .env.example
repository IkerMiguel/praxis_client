# -----------------------------------------------------------------------------
# praxis_client — variables de entorno (copia a .env y ajusta valores)
# El backend NO se expone en este proyecto: solo se consume por URL.
# -----------------------------------------------------------------------------

# URL pública del frontend (útil en links absolutos / OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API externa que consume el front (staging o local del backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Playwright (e2e)
# -----------------------------------------------------------------------------

# Base URL donde corre el Next.js bajo prueba
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Opcional: API real para e2e de integración.
# Si está vacío, los tests deben mockear con page.route().
# PLAYWRIGHT_API_URL=http://localhost:8080
